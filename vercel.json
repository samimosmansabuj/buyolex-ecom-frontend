{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/product/:slug",
      "destination": "/product-details.html?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/product-details.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.*)"
        }
      ],
      "destination": "/product/:slug",
      "permanent": true
    }
  ]
}
